{
  "name": "brewery-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/env.mjs dev dev",
    "build": "prisma generate && next build --webpack",
    "start": "node scripts/env.mjs prod start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test:integration": "node --import tsx tests/integration.mts",
    "env:init": "node scripts/init-env.mjs",
    "start:dev": "npm run dev",
    "build:prod": "node scripts/env.mjs prod generate && node scripts/env.mjs prod build",
    "start:prod": "npm run start",
    "db:up:dev": "docker compose --profile dev up -d --wait db-dev",
    "db:up:prod": "docker compose --profile prod up -d --wait db-prod",
    "db:stop:dev": "docker compose stop db-dev",
    "db:stop:prod": "docker compose stop db-prod",
    "db:migrate:dev": "node scripts/env.mjs dev migrate",
    "db:migrate:prod": "node scripts/env.mjs prod migrate",
    "setup:dev": "npm run env:init && npm run db:up:dev && node scripts/env.mjs dev generate && npm run db:migrate:dev",
    "setup:prod": "npm run env:init && npm run db:up:prod && node scripts/env.mjs prod generate && npm run db:migrate:prod",
    "start:cloud": "next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.5",
    "jsdom": "^31.0.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
